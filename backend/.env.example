# Local development (fine for testing only)
# MOSPI_DATABASE_PATH=./data/paimana.db

# Production on Render / Azure / VPS:
# Use a persistent mounted volume or managed database.
# Render example: /data/paimana.db
MOSPI_DATABASE_PATH=/data/paimana.db

